{
  "manifest_version": 3,
  "name": "Trajectory Recorder Browser Companion",
  "version": "1.0.0",
  "description": "Multimodal DOM interaction capture and SPA event telemetry for Trajectory Recorder",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "nativeMessaging",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/selector.js", "dist/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
