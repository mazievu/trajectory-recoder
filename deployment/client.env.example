# This file is for a capture-only Windows client. Do not use it on the server.
DEPLOYMENT_ROLE=client

# The explicit, externally reachable HTTPS ingestion endpoint. Never use localhost
# or 127.0.0.1 outside single-machine development.
TRAJECTORY_SERVER_URL=https://trajectory-ingest.example.com
TRAJECTORY_MACHINE_ID=CLIENT-UNIQUE-ID
TRAJECTORY_USER_ID=operator-id

# Used once to enrol and obtain a DPAPI-protected device token. Do not share
# between clients. After enrolment it may be removed from this file.
TRAJECTORY_ENROLLMENT_TOKEN=

# Local-only durable queue; client capture and uploader run without a user interface.
SPOOL_DIR=C:\ProgramData\TrajectoryRecorder\spool
