# This file is for the ingestion server only. Do not place DEVICE_TOKEN or SPOOL_DIR here.
DEPLOYMENT_ROLE=server

# Server listens only on the private Compose network. The proxy exposes HTTPS.
BIND_ADDR=0.0.0.0:8080
PUBLIC_HOSTNAME=trajectory.example.com
# Host paths to operator-provided PEM files. Do not copy TLS files into this repo.
TLS_CERT_PATH=/srv/trajectory/tls/tls.crt
TLS_KEY_PATH=/srv/trajectory/tls/tls.key
DATABASE_URL=postgres://trajectory:CHANGE_ME@postgres:5432/trajectory
POSTGRES_DB=trajectory
POSTGRES_USER=trajectory
POSTGRES_PASSWORD=CHANGE_ME
S3_ENDPOINT=https://object-store.example.com
S3_BUCKET=trajectory-archives
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ENROLLMENT_TOKEN=CHANGE_ME_TO_A_RANDOM_SECRET
DASHBOARD_API_TOKEN=CHANGE_ME_TO_A_SEPARATE_RANDOM_SECRET
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
