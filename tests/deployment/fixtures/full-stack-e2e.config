# Deliberately non-production credentials for the disposable Docker E2E stack.
# This file is a test fixture, never an operator deployment environment file.
DEPLOYMENT_ROLE=server
PUBLIC_HOSTNAME=trajectory-e2e.test
POSTGRES_DB=trajectory_e2e
POSTGRES_USER=trajectory_e2e
POSTGRES_PASSWORD=trajectory-e2e-postgres-password
DATABASE_URL=postgres://trajectory_e2e:trajectory-e2e-postgres-password@postgres:5432/trajectory_e2e
S3_BUCKET=trajectory-e2e-archives
S3_REGION=us-east-1
S3_ACCESS_KEY=trajectory-e2e-access-key
S3_SECRET_KEY=trajectory-e2e-secret-key
JWT_SECRET=trajectory-e2e-jwt-secret-at-least-32-bytes
ENROLLMENT_TOKEN=trajectory-e2e-enrollment-token
DASHBOARD_API_TOKEN=trajectory-e2e-dashboard-password-32-bytes
MINIO_ROOT_USER=trajectory-e2e-minio-user
MINIO_ROOT_PASSWORD=trajectory-e2e-minio-password
